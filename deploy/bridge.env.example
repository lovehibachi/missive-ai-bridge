# Copy to /etc/fin-missive-bridge/bridge.env on the target server.
# Keep the real file root-owned with mode 0640 and do not commit it.
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/fin_missive_bridge
DATABASE_USERNAME=fin_bridge
DATABASE_PASSWORD=replace-with-a-generated-password

MISSIVE_FIN_AI_PAT=
MISSIVE_WEBHOOK_SECRET=
# Test environment Live Chat account ID: 01a0946f-6bc6-7300-941d-e12b69ba545c
MISSIVE_LIVE_CHAT_ACCOUNT_ID=
# Optional first-party web chat via a Missive Custom Channel. Leave all four
# empty until the Custom Channel account and its recipient identity exist.
MISSIVE_CUSTOM_CHANNEL_ACCOUNT_ID=
MISSIVE_CUSTOM_CHANNEL_WEBHOOK_SECRET=
MISSIVE_CUSTOM_CHANNEL_RECIPIENT_ID=
MISSIVE_CUSTOM_CHANNEL_RECIPIENT_USERNAME=
MISSIVE_CUSTOM_CHANNEL_RECIPIENT_NAME=Love Hibachi
MISSIVE_ORGANIZATION_ID=
MISSIVE_NEED_HUMAN_LABEL_ID=
# Test environment handoff Team ID: 01a0ad0e-e4b5-72fe-b07a-f17bd5b90dea
MISSIVE_HANDOFF_TEAM_ID=
# Team Inbox where normal AI-handled Live Chat conversations should reside.
# Test environment AI Team ID: 01a09472-d9a6-7081-be9c-b1947d40cf84
MISSIVE_AI_TEAM_ID=

FIN_API_KEY=
FIN_WEBHOOK_SECRET=
INTERCOM_CLIENT_SECRET=

# Namespace for the external conversation_id sent to Fin. Leave production as
# fin:missive; use fin:test:missive on the isolated test bridge.
FIN_CONVERSATION_ID_PREFIX=fin:missive

# Configure only on the instance that receives Fin's one public callback.
# It forwards verified fin:test: callbacks to the colocated test bridge, which
# verifies the original Fin signature again. Leave both empty everywhere else.
FIN_WEBHOOK_RELAY_CONVERSATION_ID_PREFIX=
FIN_WEBHOOK_RELAY_TARGET_URL=

# Send one offer after an unanswered AI reply. Missive Live Chat renders the
# URL as a customer-facing text link with the visible text "here".
LOW_PEAK_FOLLOW_UP_ENABLED=true
LOW_PEAK_FOLLOW_UP_DELAY_SECONDS=60
LOW_PEAK_FOLLOW_UP_MAX_AGE_SECONDS=300
LOW_PEAK_BOOKING_URL=https://lovehibachi.com/booking-request/?utm_campaign=fin_low_peak

# Public URL used in customer-facing, one-time human-handoff links.
BRIDGE_PUBLIC_BASE_URL=https://aiservices.letsgohibachi.com
HANDOFF_LINK_TTL_MINUTES=1440

# Exact WordPress origin allowed to call /api/chat. Do not use '*'.
WEB_CHAT_ALLOWED_ORIGIN=https://lovehibachi.com
WEB_CHAT_LONG_POLL_TIMEOUT_MILLIS=25000

# Required only for the private operator endpoint that resumes AI handling.
# Generate a long random value and never place it in browser code.
BRIDGE_ADMIN_TOKEN=

# Keep Spring Boot reachable only through Nginx.
SERVER_ADDRESS=127.0.0.1
